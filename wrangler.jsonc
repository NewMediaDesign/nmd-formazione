// Configurazione del sito su Cloudflare Workers (solo file statici, nessun codice).
// Cloudflare la legge a ogni pubblicazione su GitHub (repository nmd-formazione); GitHub Pages la ignora.
// Guida: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "nmd-formazione",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Il sito è questa cartella. I file da non pubblicare sono in .assetsignore.
    "directory": ".",
    // /privacy.html diventa /privacy, /vibe-coding/index.html diventa /vibe-coding/
    "html_handling": "auto-trailing-slash",
    // Indirizzo sbagliato: si mostra 404.html con codice 404 (mai la pagina principale)
    "not_found_handling": "404-page"
  },
  // Domini del sito (collegati dal pannello il 25/11; qui perché la configurazione resti la fonte unica).
  // www rimanda al dominio senza www con una Redirect Rule della zona, non da qui.
  "routes": [
    { "pattern": "nmd-formazione.it", "custom_domain": true },
    { "pattern": "www.nmd-formazione.it", "custom_domain": true }
  ],
  // Indirizzo tecnico *.workers.dev spento: non fa concorrenza al dominio su Google.
  "workers_dev": false,
  "preview_urls": false
}
